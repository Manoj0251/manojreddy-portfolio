{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Angular Frontend",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/src",
      "preLaunchTask": "npm: start:frontend"
    },
    {
      "name": "Attach to Node Backend",
      "type": "pwa-node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Launch Node Backend",
      "type": "pwa-node",
      "request": "launch",
      "program": "${workspaceFolder}/server/index.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--inspect=9229"],
      "env": {
        "PORT": "3000"
      }
    }
  ]
}
